ENV=development
# Generate a real key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start while this still contains "change-me".
SECRET_KEY=change-me-change-me-change-me-32ch
POSTGRES_USER=medicare
POSTGRES_DB=medicare
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://medicare:change-me@db:5432/medicare
# Password for all demo accounts created by `python -m medicare.seed` (min 10 chars).
DEMO_PASSWORD=change-me
