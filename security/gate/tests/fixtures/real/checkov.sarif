        "artifactLocation": {
         "uri": "infra/terraform/main.tf"
        },
        "region": {
         "startLine": 15,
         "endLine": 25,
         "snippet": {
          "text": "data \"aws_iam_policy_document\" \"kms\" {\n  statement {\n    sid       = \"AccountAdministration\"\n    actions   = [\"kms:*\"]\n    resources = [\"*\"]\n    principals {\n      type        = \"AWS\"\n      identifiers = [\"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\"]\n    }\n  }\n}\n"
