              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "python-jinja2: str.format_map allows sandbox escape"
              },
              "fullDescription": {
                "text": "In Pallets Jinja before 2.10.1, str.format_map allows a sandbox escape."
