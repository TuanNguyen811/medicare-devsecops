        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Truy cập dữ liệu lâm sàng theo vai trò (mỗi phút)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (role) (increase(medicare_record_access_total[1m]))",
          "legendFormat": "{{role}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
