          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-639",
          "level": "error",
          "message": {
            "text": "IDOR: y tá xem danh sách bệnh nhân của khoa khác qua department_id: Route /ward/patients nhận department_id từ client và dùng trực tiếp, không kiểm tra bằng policy.can_*. Theo ma trận, y tá chỉ xem bệnh nhân cùng khoa. Ngoài ra danh sách còn trả họ tên, ngày sinh, giới tính, BS phụ trách, ngày khám gần nhất, và link tới hồ sơ của bệnh nhân khoa khác."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/patient/router.py"
                },
                "region": {
                  "startLine": 100
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
