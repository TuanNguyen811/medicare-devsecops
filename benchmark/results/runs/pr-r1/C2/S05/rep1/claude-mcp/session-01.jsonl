cord.visit_date),\n   84|             \"symptoms\": record.symptoms,\n   85|             \"diagnosis_code\": record.diagnosis_code,\n   86|             \"diagnosis_text\": record.diagnosis_text,\n   87|             \"notes\": record.notes,\n   88|         },\n   89|         \"doctor\": {\"full_name\": record.doctor.full_name},\n   90|         \"today\": date_vn(date.today()),\n   91|     }\n   92| \n   93| \n   94| def render_slip(db: Session, user: User, record: MedicalRecord, patient: Patient) -> str:\n   95|     custom = get_custom(db, user)\n   96|     body = custom.body if custom is not None else DEFAULT_TEMPLATE\n   97|     return _env.from_string(body).render(_context(record, patient))\n</untrusted-code>"}]}]}}
