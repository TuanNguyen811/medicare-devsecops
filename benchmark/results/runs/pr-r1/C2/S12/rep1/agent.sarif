            {
              "id": "secagent/CWE-532",
              "name": "secagent/CWE-532",
              "shortDescription": {
                "text": "Ghi PII (CCCD, mã BHYT, chẩn đoán) vào log ứng dụng"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-532"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-778",
          "level": "error",
          "message": {
            "text": "Job bảo trì xóa dòng audit log, phá vỡ tính bất biến: compact_repeated_views thực hiện delete(AuditLog) các dòng VIEW_RECORD lặp. R-06 quy định audit log chỉ được thêm, không có chức năng sửa hay xóa, và R-05 yêu cầu ghi mọi lần truy cập bệnh án. Việc xóa làm mất dấu vết các lần xem lặp lại, gây khó điều tra truy cập trái phép; job cũng chạy với quyền DB đầy đủ nên là đường xóa bằng chứng."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/audit/maintenance.py"
                },
                "region": {
                  "startLine": 41
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-532",
          "level": "error",
          "message": {
            "text": "Ghi PII (CCCD, mã BHYT, chẩn đoán) vào log ứng dụng: _log_event đưa national_id, insurance_number và diagnosis vào extra=; JsonFormatter xuất mọi trường extra thành khóa cấp cao nhất ra stderr rồi được log agent đẩy lên Loki. Điều này vi phạm R-10 (không ghi PII vào log) và còn làm lộ CCCD/BHYT đầy đủ cho cả bác sĩ/y tá (vốn bị che theo R-11) và cả người đọc log."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/service.py"
                },
                "region": {
                  "startLine": 21
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.97
          }
        }
      ]
    }
