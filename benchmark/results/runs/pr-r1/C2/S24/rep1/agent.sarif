{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-307",
              "name": "secagent/CWE-307",
              "shortDescription": {
                "text": "Remember-me token vô hiệu hóa khóa tài khoản, cho phép brute-force mật khẩu không giới hạn"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-307"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-307",
          "level": "error",
          "message": {
            "text": "Remember-me token vô hiệu hóa khóa tài khoản, cho phép brute-force mật khẩu không giới hạn: authenticate() bỏ qua kiểm tra locked_until và không tăng failed_login_count khi remembered_device=True. Cờ này chỉ dựa vào việc cookie medicare_remember của request khớp BẤT KỲ token hợp lệ nào (is_remembered_device không gắn với username đang đăng nhập). Kẻ tấn công chỉ cần có tài khoản hợp lệ của chính mình, bật \"ghi nhớ\", rồi gửi cookie đó kèm mọi lần đoán mật khẩu của tài khoản nạn nhân: không bị khóa, không bị đếm. Lỗi này phá vỡ R-07 (khóa 15 phút sau 5 lần sai). Ngoài ra khi tài khoản đang bị khóa, kẻ tấn công vẫn đăng nhập được nếu đoán đúng."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 54
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}