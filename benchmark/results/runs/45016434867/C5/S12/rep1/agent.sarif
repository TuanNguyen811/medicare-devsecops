{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-778",
              "name": "secagent/CWE-778",
              "shortDescription": {
                "text": "Job compact xóa audit log, vi phạm tính bất biến"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-778"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-532",
              "name": "secagent/CWE-532",
              "shortDescription": {
                "text": "Ghi PII (CCCD, mã BHYT, chẩn đoán) vào log"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-532"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-778",
          "level": "error",
          "message": {
            "text": "Job compact xóa audit log, vi phạm tính bất biến: compact_repeated_views thực hiện DELETE trên bảng audit_log. R-06 yêu cầu audit log chỉ thêm, không xóa; R-05 yêu cầu ghi mọi lần xem bệnh án. Xóa các lượt xem lặp làm mất dấu vết truy cập."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/audit/maintenance.py"
                },
                "region": {
                  "startLine": 41
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-532",
          "level": "error",
          "message": {
            "text": "Ghi PII (CCCD, mã BHYT, chẩn đoán) vào log: _log_event đưa national_id, insurance_number và diagnosis vào extra=; JsonFormatter đẩy mọi trường extra thành key cấp cao nhất và gửi tới Loki. Đây là PII/dữ liệu lâm sàng bị cấm ghi log theo R-10, đồng thời bỏ qua việc che CCCD/BHYT (R-11)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/service.py"
                },
                "region": {
                  "startLine": 28
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}