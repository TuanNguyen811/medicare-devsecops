{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-307",
              "name": "secagent/CWE-307",
              "shortDescription": {
                "text": "Cookie remember-me (không gắn thiết bị) bỏ qua khóa tài khoản và đếm sai mật khẩu"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-307"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-307",
          "level": "error",
          "message": {
            "text": "Cookie remember-me (không gắn thiết bị) bỏ qua khóa tài khoản và đếm sai mật khẩu: authenticate() nhận remembered_device do client điều khiển: chỉ cần cookie medicare_remember hợp lệ (bất kỳ token nào còn hạn, của bất kỳ user nào, vì is_remembered_device không gắn token với username đang đăng nhập). Khi đó tài khoản bị khóa vẫn được thử mật khẩu và sai mật khẩu không tăng failed_login_count, nên brute-force không giới hạn. Kẻ tấn công chỉ cần một remember token hợp lệ (tự đăng nhập bằng tài khoản của mình có tích 'ghi nhớ') để vô hiệu hóa R-07 cho mọi tài khoản."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 54
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}