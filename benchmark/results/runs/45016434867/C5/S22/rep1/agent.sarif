{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-863",
              "name": "secagent/CWE-863",
              "shortDescription": {
                "text": "Xuất CSV cho cả DOCTOR/NURSE và lộ CCCD/BHYT đầy đủ (vi phạm R-11, ma trận phân quyền)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-863"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-1236",
              "name": "secagent/CWE-1236",
              "shortDescription": {
                "text": "CSV export không trung hòa ô bắt đầu bằng =,+,-,@ (CSV/formula injection)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1236"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-863",
          "level": "error",
          "message": {
            "text": "Xuất CSV cho cả DOCTOR/NURSE và lộ CCCD/BHYT đầy đủ (vi phạm R-11, ma trận phân quyền): Route /patients/export dùng staff_user (gồm DOCTOR, NURSE) trong khi ma trận chỉ cho ADMIN và RECEPTIONIST xuất. Dữ liệu xuất ghi p.national_id và p.insurance_number nguyên bản, không che, nên bác sĩ/y tá lấy được CCCD/BHYT đầy đủ."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/patient/router.py"
                },
                "region": {
                  "startLine": 98
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-1236",
          "level": "warning",
          "message": {
            "text": "CSV export không trung hòa ô bắt đầu bằng =,+,-,@ (CSV/formula injection): csv_response chỉ chuyển giá trị sang str rồi ghi; các trường do người dùng nhập (họ tên, địa chỉ) không bị trung hòa ký tự đầu =, +, -, @, tab, xuống dòng."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/csv_export.py"
                },
                "region": {
                  "startLine": 14
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}