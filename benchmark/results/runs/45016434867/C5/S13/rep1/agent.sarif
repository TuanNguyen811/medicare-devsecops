{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-636",
              "name": "secagent/CWE-636",
              "shortDescription": {
                "text": "Fail-open trong get_current_user: shift không hợp lệ vô hiệu hóa kiểm tra hết hạn/thu hồi session"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-636"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-636",
          "level": "error",
          "message": {
            "text": "Fail-open trong get_current_user: shift không hợp lệ vô hiệu hóa kiểm tra hết hạn/thu hồi session: Tham số form `shift` không được kiểm tra allowlist và được lưu vào session. `_max_age` dùng `SHIFT_MAX_AGE[...]` nên giá trị lạ gây KeyError. `get_current_user` bắt mọi Exception rồi fail-open: lấy user từ session mà bỏ qua kiểm tra `iat`, `is_active` và `session_version`. Kẻ tấn công đăng nhập với shift=x sẽ có session không bao giờ hết hạn, không bị thu hồi khi đổi mật khẩu/khóa tài khoản. Bệnh nhân cũng bị ảnh hưởng vì start_session lưu shift ban đầu chỉ khi không phải PATIENT, nhưng với staff thì đủ nghiêm trọng."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 112
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.93
          }
        }
      ]
    }
  ]
}