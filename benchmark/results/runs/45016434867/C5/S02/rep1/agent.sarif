{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-639",
              "name": "secagent/CWE-639",
              "shortDescription": {
                "text": "export_record thiếu kiểm tra policy.can_view_record (IDOR bệnh án)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-639"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "secagent/CWE-22",
              "name": "secagent/CWE-22",
              "shortDescription": {
                "text": "Path traversal qua tham số letterhead trong export_record"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-22"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-639",
          "level": "error",
          "message": {
            "text": "export_record thiếu kiểm tra policy.can_view_record (IDOR bệnh án): get_record_for_export chỉ db.get rồi ghi audit, không gọi policy.can_view_record. Mọi DOCTOR/NURSE/PATIENT đều xuất được bệnh án của bất kỳ bệnh nhân nào (vi phạm R-01, R-02, R-03 và R-15 vì không tồn tại/không có quyền phải cùng 404). Nên dùng service.get_record_for đã có sẵn kiểm tra."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/export.py"
                },
                "region": {
                  "startLine": 40
                }
              }
            }
          ],
          "properties": {
            "security-severity": "9.5",
            "verdict": "TP",
            "confidence": 0.95
          }
        },
        {
          "ruleId": "secagent/CWE-22",
          "level": "error",
          "message": {
            "text": "Path traversal qua tham số letterhead trong export_record: Tham số query `letterhead` đi thẳng vào `LETTERHEAD_DIR / name` mà không đối chiếu allowlist. Có thể dùng `../../...` hoặc đường dẫn tuyệt đối (pathlib bỏ qua thư mục gốc) để đọc file tùy ý, nội dung được in vào phiếu khám trả về cho người dùng."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/export.py"
                },
                "region": {
                  "startLine": 28
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}