{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-1336",
              "name": "secagent/CWE-1336",
              "shortDescription": {
                "text": "SSTI: render mẫu Jinja do bác sĩ nhập bằng Environment không sandbox"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1336"
                ],
                "security-severity": "9.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-1336",
          "level": "error",
          "message": {
            "text": "SSTI: render mẫu Jinja do bác sĩ nhập bằng Environment không sandbox: printing.py dùng jinja2.Environment(autoescape=True) thường (không SandboxedEnvironment) và gọi _env.from_string(body).render(...) với body do bác sĩ gửi qua POST /account/print-template. validate() chỉ parse cú pháp, không hạn chế thuộc tính/gọi hàm. Bác sĩ có thể dùng {{ ''.__class__.__mro__[1].__subclasses__() }} để thực thi mã tùy ý trên server (RCE), đọc biến môi trường (SECRET_KEY, DB URL) và toàn bộ dữ liệu bệnh án."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/printing.py"
                },
                "region": {
                  "startLine": 97
                }
              }
            }
          ],
          "properties": {
            "security-severity": "9.5",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}