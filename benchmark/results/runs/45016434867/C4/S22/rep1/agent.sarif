{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-1236",
              "name": "secagent/CWE-1236",
              "shortDescription": {
                "text": "CSV injection (formula injection) trong xuất danh sách bệnh nhân"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1236"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-1236",
          "level": "warning",
          "message": {
            "text": "CSV injection (formula injection) trong xuất danh sách bệnh nhân: csv_response ghi trực tiếp str(value) của các trường do người dùng nhập (full_name, address, phone...) mà không vô hiệu hóa ký tự đầu =, +, -, @, tab, CR. Khi nhân viên mở CSV bằng Excel, công thức có thể được thực thi (rò rỉ dữ liệu, DDE)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/csv_export.py"
                },
                "region": {
                  "startLine": 15
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.7
          }
        }
      ]
    }
  ]
}