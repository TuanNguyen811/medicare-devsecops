{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-1336",
              "name": "secagent/CWE-1336",
              "shortDescription": {
                "text": "Server-Side Template Injection: bác sĩ tự soạn mẫu Jinja, render bằng Environment không sandbox"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1336"
                ],
                "security-severity": "9.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-1336",
          "level": "error",
          "message": {
            "text": "Server-Side Template Injection: bác sĩ tự soạn mẫu Jinja, render bằng Environment không sandbox: printing.py dùng jinja2.Environment(autoescape=True) thông thường (không phải SandboxedEnvironment) rồi gọi _env.from_string(body).render(...) với body do bác sĩ nhập. validate() chỉ kiểm tra độ dài và cú pháp, không hạn chế truy cập thuộc tính. Dù context chỉ chứa dict/chuỗi, payload như {{ ''.__class__.__mro__[1].__subclasses__() }} cho phép truy cập object Python và thực thi mã tùy ý (RCE) trên server. Ngoài ra, slip.html in kết quả bằng |safe nên bác sĩ cũng có thể lưu HTML/JS (stored XSS), mẫu này còn được dùng khi in phiếu."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/printing.py"
                },
                "region": {
                  "startLine": 38
                }
              }
            }
          ],
          "properties": {
            "security-severity": "9.5",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}