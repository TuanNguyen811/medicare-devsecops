{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-307",
              "name": "secagent/CWE-307",
              "shortDescription": {
                "text": "Cookie remember-me (do client kiểm soát) vô hiệu hóa cơ chế khóa tài khoản R-07"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-307"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-307",
          "level": "error",
          "message": {
            "text": "Cookie remember-me (do client kiểm soát) vô hiệu hóa cơ chế khóa tài khoản R-07: Route /login gọi authenticate(..., remembered_device=remember.is_remembered_device(db, request, now)). Hàm này trả True khi cookie medicare_remember khớp với BẤT KỲ RememberToken còn hạn của user nào, không gắn với username đang đăng nhập. Khi remembered_device=True, authenticate bỏ qua kiểm tra locked_until và không tăng failed_login_count khi sai mật khẩu. Kẻ tấn công chỉ cần một tài khoản hợp lệ, chọn \"Ghi nhớ đăng nhập\" để lấy token hợp lệ, rồi gửi cookie đó kèm mọi lần đoán mật khẩu của tài khoản nạn nhân. Brute-force không giới hạn, và tài khoản đang bị khóa vẫn đăng nhập được."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 54
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}