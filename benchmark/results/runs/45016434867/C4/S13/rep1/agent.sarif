{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-636",
              "name": "secagent/CWE-636",
              "shortDescription": {
                "text": "get_current_user fail-open: lỗi khi kiểm tra phiên vẫn chấp nhận session"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-636"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-613",
              "name": "secagent/CWE-613",
              "shortDescription": {
                "text": "Thời hạn phiên do client tự chọn qua tham số shift, không có kiểm soát phía server"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-613"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-636",
          "level": "error",
          "message": {
            "text": "get_current_user fail-open: lỗi khi kiểm tra phiên vẫn chấp nhận session: Trong get_current_user, khi _session_user ném exception, code bắt `except Exception` rồi lấy lại user chỉ từ user_id trong session, bỏ qua kiểm tra session_version, is_active và thời hạn tuyệt đối. Đây là fail-open: phiên đã bị thu hồi (revoke_sessions), tài khoản bị khóa hoặc phiên hết hạn vẫn được chấp nhận nếu gây được lỗi (ví dụ session['shift'] có giá trị lạ gây KeyError trong _max_age)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 114
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-613",
          "level": "warning",
          "message": {
            "text": "Thời hạn phiên do client tự chọn qua tham số shift, không có kiểm soát phía server: Form field shift được người đăng nhập tự gửi; start_session lưu thẳng vào session và chỉ loại trừ PATIENT. Mọi nhân viên (hay kẻ có mật khẩu bị lộ) có thể chọn 24h; không kiểm tra ca thực tế. Giá trị không hợp lệ (shift=abc) được lưu mà không validate, khiến SHIFT_MAX_AGE[...] ném KeyError, kết hợp với nhánh fail-open ở get_current_user làm mất hoàn toàn kiểm tra hết hạn/thu hồi phiên: phiên tồn tại vĩnh viễn."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 73
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.85
          }
        }
      ]
    }
  ]
}