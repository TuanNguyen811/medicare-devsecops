{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-611",
              "name": "secagent/CWE-611",
              "shortDescription": {
                "text": "XXE: lxml XMLParser resolve_entities=True khi nhập file XML"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-611"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-611",
          "level": "error",
          "message": {
            "text": "XXE: lxml XMLParser resolve_entities=True khi nhập file XML: _parse_xml bật resolve_entities=True trên XML do người dùng tải lên, cho phép thực thể ngoài (file:///etc/passwd, URL nội bộ/SSRF) và billion laughs. Nội dung thực thể có thể đi vào ten_thuoc rồi lưu DB và hiển thị."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/prescription/legacy_import.py"
                },
                "region": {
                  "startLine": 49
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}