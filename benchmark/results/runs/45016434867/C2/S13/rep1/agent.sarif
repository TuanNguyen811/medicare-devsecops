          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-636",
              "name": "secagent/CWE-636",
              "shortDescription": {
                "text": "get_current_user fail-open: lỗi khi kiểm tra session thì bỏ qua mọi kiểm tra; shift không được validate"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-636"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-636",
          "level": "error",
          "message": {
            "text": "get_current_user fail-open: lỗi khi kiểm tra session thì bỏ qua mọi kiểm tra; shift không được validate: Khi _session_user ném exception, nhánh except lấy user trực tiếp bằng db.get theo user_id mà không kiểm tra is_active, session_version (sv) hay thời hạn tuyệt đối (iat). Giá trị shift từ form được lưu vào session mà không validate; shift lạ khiến SHIFT_MAX_AGE[...] ném KeyError ở mọi request, nên session đó luôn đi vào nhánh fail-open: không bao giờ hết hạn và không bị revoke_sessions / khóa tài khoản vô hiệu hóa."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 115
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
