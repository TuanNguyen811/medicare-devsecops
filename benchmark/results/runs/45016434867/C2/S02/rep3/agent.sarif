  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-22",
              "name": "secagent/CWE-22",
              "shortDescription": {
                "text": "Path traversal qua tham số letterhead"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-22"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-639",
              "name": "secagent/CWE-639",
              "shortDescription": {
                "text": "IDOR: export_record không kiểm tra policy.can_view_record"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-639"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-862",
              "name": "secagent/CWE-862",
              "shortDescription": {
                "text": "Header Content-Disposition/export: audit trước khi kiểm tra quyền, nurse khác khoa xuất được"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-862"
                ],
                "security-severity": "3.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-22",
          "level": "error",
          "message": {
            "text": "Path traversal qua tham số letterhead: read_letterhead ghép trực tiếp tên do người dùng gửi (query letterhead) vào LETTERHEAD_DIR mà không đối chiếu allowlist. Giá trị như ../../../../etc/passwd hoặc đường dẫn tuyệt đối đọc được file bất kỳ (UTF-8) và nội dung được chèn vào phiếu xuất. Vi phạm R-14."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/export.py"
                },
                "region": {
                  "startLine": 27
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-639",
          "level": "error",
          "message": {
            "text": "IDOR: export_record không kiểm tra policy.can_view_record: get_record_for_export chỉ gọi db.get(MedicalRecord, record_id) rồi ghi audit, không gọi policy.can_view_record(user, patient). Mọi DOCTOR/NURSE/PATIENT đăng nhập đều xuất được bệnh án của bất kỳ bệnh nhân nào, vi phạm R-01, R-02, R-12. Ngoài ra bệnh án không tồn tại và không có quyền phải cùng trả 404 (R-15)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/export.py"
                },
                "region": {
                  "startLine": 40
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        },
        {
          "ruleId": "secagent/CWE-862",
          "level": "note",
          "message": {
            "text": "Header Content-Disposition/export: audit trước khi kiểm tra quyền, nurse khác khoa xuất được: Ghi chú phụ: route dùng clinical_user chỉ theo vai trò, không có kiểm tra theo đối tượng; đã nêu ở finding IDOR."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/router.py"
                },
