      },
      "results": [
        {
          "ruleId": "secagent/CWE-22",
          "level": "error",
          "message": {
            "text": "Path traversal qua tham số letterhead trong read_letterhead: Tham số query letterhead do người dùng kiểm soát được nối trực tiếp vào LETTERHEAD_DIR / name mà không đối chiếu allowlist (letterheads()). Giá trị như ../../../../etc/passwd hoặc đường dẫn tuyệt đối (pathlib bỏ qua thư mục gốc) sẽ được đọc và chèn vào nội dung file tải xuống. Vi phạm R-14."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/export.py"
                },
                "region": {
                  "startLine": 28
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-639",
          "level": "error",
          "message": {
            "text": "IDOR: export bệnh án không kiểm tra policy.can_view_record: get_record_for_export chỉ db.get rồi ghi audit, không gọi policy.can_view_record. Bất kỳ DOCTOR/NURSE/PATIENT nào đăng nhập đều xuất được bệnh án của bệnh nhân khác (khác khoa, không phụ trách, không phải của mình), vi phạm R-01, R-02, R-12. Ngoài ra bản ghi tồn tại nhưng không có quyền cũng không trả 404 (R-15)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/export.py"
                },
                "region": {
                  "startLine": 38
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
