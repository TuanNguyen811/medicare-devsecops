{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-22",
              "name": "secagent/CWE-22",
              "shortDescription": {
                "text": "Path traversal qua tham số letterhead"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-22"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-639",
              "name": "secagent/CWE-639",
              "shortDescription": {
                "text": "Export bệnh án không kiểm tra quyền đối tượng (IDOR)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-639"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-79",
              "name": "secagent/CWE-79",
              "shortDescription": {
                "text": "Header Content-Disposition/HTML: xuất HTML không chống XSS rõ ràng cho dữ liệu letterhead đọc tùy ý"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-79"
                ],
                "security-severity": "3.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-22",
          "level": "error",
          "message": {
            "text": "Path traversal qua tham số letterhead: Tham số query letterhead do người dùng cung cấp được nối thẳng vào LETTERHEAD_DIR / name mà không đối chiếu allowlist. Có thể dùng ../ hoặc đường dẫn tuyệt đối để đọc file UTF-8 bất kỳ trên server (ví dụ ../../../.env), nội dung được chèn vào phần đầu của file xuất. Vi phạm R-14."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/export.py"
                },
                "region": {
                  "startLine": 28
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-639",
          "level": "error",
          "message": {
            "text": "Export bệnh án không kiểm tra quyền đối tượng (IDOR): get_record_for_export chỉ db.get(MedicalRecord) rồi trả về; không gọi policy.can_view_record. Route chỉ kiểm tra vai trò (DOCTOR/NURSE/PATIENT), nên bất kỳ bác sĩ/y tá khác khoa hay bệnh nhân khác đều tải được bệnh án của người khác bằng cách đổi record_id. Vi phạm R-01, R-02, R-15; còn ghi audit trước khi kiểm tra quyền."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/export.py"
                },
                "region": {
                  "startLine": 40
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-79",
          "level": "note",
          "message": {
            "text": "Header Content-Disposition/HTML: xuất HTML không chống XSS rõ ràng cho dữ liệu letterhead đọc tùy ý: Template được render bằng templates.get_template(...).render trực tiếp; cần đảm bảo autoescape bật cho môi trường này (không qua render()). Nếu tắt, các trường như symptoms/notes sẽ gây XSS."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/router.py"
                },
                "region": {
                  "startLine": 139
                }
              }
            }
          ],
          "properties": {
            "security-severity": "3.0",
            "verdict": "TP",
            "confidence": 0.4
          }
        }
      ]
    }
  ]
}