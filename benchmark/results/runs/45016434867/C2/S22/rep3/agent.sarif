{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-285",
              "name": "secagent/CWE-285",
              "shortDescription": {
                "text": "Xuất CSV cho phép DOCTOR/NURSE và lộ CCCD, BHYT đầy đủ (vi phạm ma trận quyền, R-11, R-19)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-285"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-1236",
              "name": "secagent/CWE-1236",
              "shortDescription": {
                "text": "CSV injection: ô bắt đầu bằng = + - @ không được trung hòa (R-19)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1236"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-285",
          "level": "error",
          "message": {
            "text": "Xuất CSV cho phép DOCTOR/NURSE và lộ CCCD, BHYT đầy đủ (vi phạm ma trận quyền, R-11, R-19): Route /patients/export dùng staff_user (gồm DOCTOR, NURSE) trong khi ma trận chỉ cho ADMIN và RECEPTIONIST xuất dữ liệu. Ngoài ra p.national_id và p.insurance_number được xuất nguyên văn, không che (mask) theo vai trò, nên bác sĩ và y tá lấy được CCCD/BHYT đầy đủ của tới 5000 bệnh nhân trong phạm vi của họ."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/patient/router.py"
                },
                "region": {
                  "startLine": 98
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-1236",
          "level": "warning",
          "message": {
            "text": "CSV injection: ô bắt đầu bằng = + - @ không được trung hòa (R-19): csv_response ghi str(value) trực tiếp. Họ tên, địa chỉ do lễ tân nhập (hoặc dữ liệu nhập từ bên ngoài) có thể bắt đầu bằng =, +, -, @, tab; khi quản trị mở file trong Excel, công thức sẽ được thực thi. Ngoài ra filename đưa vào header Content-Disposition không được kiểm tra (hiện là hằng nên rủi ro thấp)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/csv_export.py"
                },
                "region": {
                  "startLine": 14
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}