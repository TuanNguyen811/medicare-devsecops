{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-285",
              "name": "secagent/CWE-285",
              "shortDescription": {
                "text": "Export CSV cho DOCTOR/NURSE, lộ CCCD/BHYT không che (vi phạm R-11, R-19, ma trận quyền)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-285"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-1236",
              "name": "secagent/CWE-1236",
              "shortDescription": {
                "text": "CSV injection: csv_response không trung hòa ô bắt đầu bằng = + - @"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1236"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-285",
          "level": "error",
          "message": {
            "text": "Export CSV cho DOCTOR/NURSE, lộ CCCD/BHYT không che (vi phạm R-11, R-19, ma trận quyền): /patients/export dùng staff_user (gồm DOCTOR, NURSE) trong khi ma trận chỉ cho ADMIN và RECEPTIONIST xuất. Dòng xuất ghi p.national_id và p.insurance_number nguyên văn, không qua mask, nên bác sĩ/y tá lấy được CCCD/BHYT đầy đủ, trái R-11."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/patient/router.py"
                },
                "region": {
                  "startLine": 98
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-1236",
          "level": "warning",
          "message": {
            "text": "CSV injection: csv_response không trung hòa ô bắt đầu bằng = + - @: csv_response chỉ chuyển str(value) rồi ghi, không xử lý ký tự đầu công thức. Các trường như họ tên, địa chỉ do người dùng nhập có thể là công thức Excel."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/csv_export.py"
                },
                "region": {
                  "startLine": 14
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}