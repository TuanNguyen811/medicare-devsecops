{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-862",
              "name": "secagent/CWE-862",
              "shortDescription": {
                "text": "Export CSV cho phép DOCTOR/NURSE xuất CCCD, BHYT đầy đủ (không che)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-862"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-1236",
              "name": "secagent/CWE-1236",
              "shortDescription": {
                "text": "CSV formula injection trong csv_response"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1236"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-862",
          "level": "error",
          "message": {
            "text": "Export CSV cho phép DOCTOR/NURSE xuất CCCD, BHYT đầy đủ (không che): Route /patients/export dùng staff_user (gồm DOCTOR, NURSE) trong khi ma trận chỉ cho ADMIN và RECEPTIONIST xuất danh sách. Dữ liệu xuất ghi p.national_id và p.insurance_number thô, không qua mask, vi phạm R-11/R-19."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/patient/router.py"
                },
                "region": {
                  "startLine": 102
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-1236",
          "level": "warning",
          "message": {
            "text": "CSV formula injection trong csv_response: Các giá trị chuỗi (full_name, address, ...) do người dùng nhập được ghi trực tiếp vào CSV mà không trung hòa ô bắt đầu bằng =, +, -, @, tab hoặc xuống dòng, vi phạm R-19."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/csv_export.py"
                },
                "region": {
                  "startLine": 15
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}