  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-1336",
              "name": "secagent/CWE-1336",
              "shortDescription": {
                "text": "SSTI: render mẫu Jinja do bác sĩ nhập bằng Environment không sandbox"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1336"
                ],
                "security-severity": "9.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-1336",
          "level": "error",
          "message": {
            "text": "SSTI: render mẫu Jinja do bác sĩ nhập bằng Environment không sandbox: printing.py dùng jinja2.Environment thường (không SandboxedEnvironment) và from_string(body).render() trên body do bác sĩ gửi lên. validate() chỉ parse cú pháp. Bác sĩ có thể dùng {{ record.__class__.__init__.__globals__ ... }} hoặc cycler/lipsum để truy cập os và thực thi mã tùy ý trên server, đọc SECRET_KEY, DB toàn bộ PII. Ngoài ra slip.html dùng |safe nên HTML/JS của bác sĩ chạy trong origin ứng dụng khi bệnh nhân/bác sĩ khác mở phiếu (với người dùng được xem). Ghi chú: slip chỉ dùng template của người xem, nhưng XSS/SSTI vẫn là tự gây ra + RCE."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/printing.py"
                },
                "region": {
                  "startLine": 97
                }
              }
            }
          ],
          "properties": {
            "security-severity": "9.5",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}