          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-639",
          "level": "error",
          "message": {
            "text": "Bác sĩ bất kỳ có thể tự nhận phụ trách bệnh nhân bất kỳ (IDOR / leo thang quyền): service.claim_patient chỉ kiểm tra vai trò DOCTOR (ở router) rồi gán attending_doctor_id = doctor.id cho bất kỳ patient_id nào, không qua policy.can_*. Không kiểm tra cùng khoa, nên bác sĩ khoa khác chiếm quyền phụ trách, từ đó được xem/sửa bệnh án và kê đơn (R-02, R-03). Khi bệnh nhân chưa có khoa, bác sĩ còn gán luôn khoa của mình. Không có audit log và không có bước đối chiếu bác sĩ phụ trách hiện tại. Bệnh nhân không tồn tại và không có quyền cũng không trả 404 giống nhau (R-15)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/patient/service.py"
                },
                "region": {
                  "startLine": 129
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
