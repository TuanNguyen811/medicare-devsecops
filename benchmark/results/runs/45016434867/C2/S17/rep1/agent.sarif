          "rules": [
            {
              "id": "secagent/CWE-915",
              "name": "secagent/CWE-915",
              "shortDescription": {
                "text": "Mass assignment trong /account/profile: ProfileForm extra=\"allow\" cho phép ghi role, department_id, patient_id, is_active"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-915"
                ],
                "security-severity": "9.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-915",
          "level": "error",
          "message": {
            "text": "Mass assignment trong /account/profile: ProfileForm extra=\"allow\" cho phép ghi role, department_id, patient_id, is_active: ProfileForm khai báo extra=\"allow\" nên mọi trường form thừa đều được giữ lại trong model. update_profile lặp qua form.model_dump(exclude={\"csrf_token\"}) và setattr lên User cho từng khóa, nên các trường như role, department_id, patient_id, is_active, password_hash cũng bị ghi. Điều này vi phạm R-16: server phải bỏ qua hoặc từ chối mọi trường ngoài allowlist (full_name, phone)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/auth/schemas.py"
                },
                "region": {
                  "startLine": 9
                }
              }
            }
          ],
          "properties": {
            "security-severity": "9.5",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
