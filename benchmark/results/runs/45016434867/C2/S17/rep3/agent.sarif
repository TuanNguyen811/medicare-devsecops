        {
          "ruleId": "secagent/CWE-915",
          "level": "error",
          "message": {
            "text": "Mass assignment trong /account/profile: ProfileForm extra=\"allow\" cho phép ghi role, department_id, patient_id, is_active: ProfileForm khai báo extra=\"allow\" nên mọi trường form thừa (vd role, department_id, patient_id, is_active, password_hash) được giữ lại trong model. update_profile gọi form.model_dump(exclude={\"csrf_token\"}) rồi setattr từng cặp lên user, nên các trường thừa đó được ghi thẳng vào bản ghi User. Người dùng bất kỳ có thể tự nâng quyền lên ADMIN hoặc gắn tài khoản vào hồ sơ bệnh nhân khác. Vi phạm R-16: server phải bỏ qua hoặc từ chối mọi trường ngoài họ tên và số điện thoại."
          },
          "locations": [
            {
              "physicalLocation": {
