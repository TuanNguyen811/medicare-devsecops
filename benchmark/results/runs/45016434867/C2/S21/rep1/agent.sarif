{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-613",
              "name": "secagent/CWE-613",
              "shortDescription": {
                "text": "Token đặt lại mật khẩu không hết hạn sau 15 phút và dùng được nhiều lần"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-613"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-204",
              "name": "secagent/CWE-204",
              "shortDescription": {
                "text": "Liệt kê tài khoản qua phản hồi khác nhau của /forgot-password"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-204"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-613",
          "level": "error",
          "message": {
            "text": "Token đặt lại mật khẩu không hết hạn sau 15 phút và dùng được nhiều lần: RESET_TOKEN_TTL được khai báo nhưng chỉ dùng để in số phút trong email. user_for_token không kiểm tra created_at, và reset_password không xóa hay đánh dấu token đã dùng. Vì vậy liên kết có hiệu lực vô thời hạn và dùng lại được, trái với R-18."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/auth/reset.py"
                },
                "region": {
                  "startLine": 48
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        },
        {
          "ruleId": "secagent/CWE-204",
          "level": "warning",
          "message": {
            "text": "Liệt kê tài khoản qua phản hồi khác nhau của /forgot-password: Khi email không tồn tại, server trả form kèm lỗi \"Không tìm thấy tài khoản nào đăng ký với email này\". Khi tồn tại, server trả 303 về /login. Hai phản hồi khác nhau cho phép dò email nhân viên và bệnh nhân. R-18 yêu cầu phản hồi giống hệt nhau. Endpoint cũng không giới hạn tần suất."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/auth/router.py"
                },
                "region": {
                  "startLine": 123
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}