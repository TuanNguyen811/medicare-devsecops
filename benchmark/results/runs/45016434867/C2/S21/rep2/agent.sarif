{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-640",
              "name": "secagent/CWE-640",
              "shortDescription": {
                "text": "Token đặt lại mật khẩu không hết hạn và dùng lại được nhiều lần"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-640"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-204",
              "name": "secagent/CWE-204",
              "shortDescription": {
                "text": "Liệt kê tài khoản (user enumeration) qua /forgot-password"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-204"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-640",
          "level": "error",
          "message": {
            "text": "Token đặt lại mật khẩu không hết hạn và dùng lại được nhiều lần: RESET_TOKEN_TTL được định nghĩa nhưng user_for_token không kiểm tra created_at. reset_password cũng không xóa/đánh dấu đã dùng token. Token vì vậy có hiệu lực vĩnh viễn và dùng được nhiều lần, vi phạm R-18 (một lần, 15 phút). Các token cũ của cùng user cũng không bị vô hiệu khi yêu cầu token mới hoặc sau khi đổi mật khẩu."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/auth/reset.py"
                },
                "region": {
                  "startLine": 47
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        },
        {
          "ruleId": "secagent/CWE-204",
          "level": "warning",
          "message": {
            "text": "Liệt kê tài khoản (user enumeration) qua /forgot-password: Khi email không tồn tại, server trả 200 kèm lỗi \"Không tìm thấy tài khoản...\"; khi tồn tại trả 303 redirect. Phản hồi khác nhau, vi phạm R-18/R-07. Endpoint công khai và không có giới hạn tần suất, nên có thể dò email nhân viên/bệnh nhân hàng loạt hoặc spam mail."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/auth/router.py"
                },
                "region": {
                  "startLine": 123
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}