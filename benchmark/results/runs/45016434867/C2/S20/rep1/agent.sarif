{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-20",
              "name": "secagent/CWE-20",
              "shortDescription": {
                "text": "Số lượng dòng hóa đơn không kiểm tra là số nguyên dương"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-20"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-840",
              "name": "secagent/CWE-840",
              "shortDescription": {
                "text": "change_status cho phép hóa đơn quay ngược PAID → UNPAID"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-840"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-20",
          "level": "error",
          "message": {
            "text": "Số lượng dòng hóa đơn không kiểm tra là số nguyên dương: parse_lines chỉ gọi int(quantity), không kiểm tra > 0 và không có giới hạn trên (min/max chỉ ở HTML, client có thể bỏ qua). Số lượng 0 hoặc âm tạo amount âm, làm giảm tổng tiền hóa đơn (kể cả xuống âm). Số quá lớn có thể làm tràn Numeric(12,0) và gây lỗi 500. R-17 yêu cầu số lượng là số nguyên dương."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/billing/service.py"
                },
                "region": {
                  "startLine": 116
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-840",
          "level": "error",
          "message": {
            "text": "change_status cho phép hóa đơn quay ngược PAID → UNPAID: service.change_status chỉ kiểm tra status nằm trong InvoiceStatus và khác trạng thái hiện tại. Do đó POST /invoices/{id}/status với status=UNPAID trên hóa đơn đã PAID vẫn được chấp nhận. Việc này vi phạm R-17 (chỉ UNPAID→PAID, không quay ngược). Sau khi hoàn tác, lễ tân có thể thêm dòng dịch vụ vào hóa đơn đã thu tiền, rồi thu lại tiền (khả năng biển thủ)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/billing/service.py"
                },
                "region": {
                  "startLine": 144
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}