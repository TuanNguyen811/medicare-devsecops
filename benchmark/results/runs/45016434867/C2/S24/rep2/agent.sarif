{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-307",
              "name": "secagent/CWE-307",
              "shortDescription": {
                "text": "Bypass khóa tài khoản/brute-force mật khẩu qua cookie remember-me của bất kỳ người dùng nào"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-307"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-307",
          "level": "error",
          "message": {
            "text": "Bypass khóa tài khoản/brute-force mật khẩu qua cookie remember-me của bất kỳ người dùng nào: login() gọi authenticate(..., remembered_device=remember.is_remembered_device(...)). Hàm này chỉ kiểm tra cookie chứa token hợp lệ của BẤT KỲ người dùng nào, không gắn với username đang đăng nhập. Khi remembered_device=True, authenticate bỏ qua kiểm tra locked_until và không tăng failed_login_count, nên không còn giới hạn số lần đoán mật khẩu và tài khoản đang bị khóa vẫn được đăng nhập nếu đoán đúng. Kẻ tấn công chỉ cần một tài khoản hợp lệ có tick \"Ghi nhớ\" để lấy cookie."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 54
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}