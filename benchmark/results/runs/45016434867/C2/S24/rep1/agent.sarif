  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-307",
              "name": "secagent/CWE-307",
              "shortDescription": {
                "text": "Bỏ qua khóa tài khoản và đếm lần sai khi có cookie remember-me bất kỳ (brute-force không giới hạn)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-307"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-307",
          "level": "error",
          "message": {
            "text": "Bỏ qua khóa tài khoản và đếm lần sai khi có cookie remember-me bất kỳ (brute-force không giới hạn): authenticate() với remembered_device=True bỏ qua kiểm tra locked_until và không tăng failed_login_count. Cờ này được tính bởi is_remembered_device(), chỉ kiểm tra cookie có token hợp lệ của BẤT KỲ user nào, không ràng buộc với username đang đăng nhập. Kẻ tấn công có tài khoản hợp lệ (ví dụ bệnh nhân) bật \"ghi nhớ\", rồi gửi cookie đó kèm username của bác sĩ/admin để đoán mật khẩu không giới hạn, vô hiệu hóa R-07 (khóa 15 phút sau 5 lần sai). Cookie bị đánh cắp cũng cho phép tương tự."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/auth.py"
                },
                "region": {
                  "startLine": 54
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}