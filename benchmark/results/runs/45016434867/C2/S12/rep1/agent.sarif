{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-778",
              "name": "secagent/CWE-778",
              "shortDescription": {
                "text": "Job compact_repeated_views xóa dòng audit log (audit không bất biến)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-778"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-532",
              "name": "secagent/CWE-532",
              "shortDescription": {
                "text": "Ghi PII (CCCD, BHYT, chẩn đoán) vào log trong record/service._log_event"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-532"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-778",
          "level": "error",
          "message": {
            "text": "Job compact_repeated_views xóa dòng audit log (audit không bất biến): maintenance.py thực hiện delete(AuditLog) các dòng VIEW_RECORD lặp trong cửa sổ 30 phút. R-06 yêu cầu audit log chỉ thêm, không xóa; R-05 yêu cầu ghi mọi lần xem bệnh án. Việc xóa làm mất dấu vết các lần truy cập (thời điểm, IP) và có thể che giấu truy cập trái phép; tham số --window-minutes tùy ý cho phép xóa rộng hơn."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/audit/maintenance.py"
                },
                "region": {
                  "startLine": 41
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-532",
          "level": "error",
          "message": {
            "text": "Ghi PII (CCCD, BHYT, chẩn đoán) vào log trong record/service._log_event: _log_event đưa national_id, insurance_number và diagnosis vào extra=; JsonFormatter đẩy mọi extra thành key JSON ra stderr rồi gửi lên Loki. Vi phạm R-10 (không ghi PII vào log) và còn bỏ qua việc che CCCD/BHYT theo R-11, vai trò log không bị giới hạn."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/service.py"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}