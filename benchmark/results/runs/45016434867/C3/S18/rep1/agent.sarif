          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-362",
          "level": "warning",
          "message": {
            "text": "Mất ràng buộc DB chống đặt trùng lịch bác sĩ, kiểm tra overlap chỉ ở tầng ứng dụng (race condition): PR xóa unique index `uq_doctor_slot_active` và bỏ xử lý IntegrityError. `book()` giờ chỉ gọi `_active_around()` (SELECT) rồi `db.add` và `flush` mà không có khóa hay ràng buộc DB. Hai request đồng thời cùng thấy khung giờ trống và cùng insert, nên một bác sĩ có hai lịch hẹn còn hiệu lực trùng giờ, vi phạm R-13. Trước đây DB là nguồn sự thật. Tính năng đặt lịch nhanh cho phép bất kỳ bệnh nhân nào gọi endpoint này, nên dễ khai thác bằng request song song."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/appointment/service.py"
                },
                "region": {
                  "startLine": 133
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.85
          }
        }
      ]
    }
  ]
