      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-639",
              "name": "secagent/CWE-639",
              "shortDescription": {
                "text": "IDOR: can_reschedule_appointment không kiểm tra bệnh nhân sở hữu lịch hẹn"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-639"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-639",
          "level": "error",
          "message": {
            "text": "IDOR: can_reschedule_appointment không kiểm tra bệnh nhân sở hữu lịch hẹn: Với vai trò PATIENT, hàm chỉ kiểm tra user.patient_id is not None và status == REQUESTED, không so sánh user.patient_id với appt.patient_id (khác với can_cancel_appointment). Vì vậy mọi bệnh nhân đều đổi được lịch REQUESTED của bệnh nhân khác qua POST /appointments/{id}/reschedule, và GET cùng route làm lộ mã và tên bệnh nhân khác trong reschedule.html. Vi phạm R-01 và R-13. Các test chỉ kiểm tra 'self' nên không phát hiện lỗi này."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/policy.py"
                },
                "region": {
                  "startLine": 119
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}