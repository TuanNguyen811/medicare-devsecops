          "message": {
            "text": "Mass assignment ở POST /account/profile cho phép tự nâng quyền (role, department_id, patient_id, is_active): ProfileForm khai báo extra=\"allow\" nên mọi trường client gửi thêm đều được giữ lại trong model_dump(). Handler update_profile chỉ loại csrf_token rồi setattr từng cặp lên đối tượng User, nên người dùng có thể gửi role=ADMIN, department_id, patient_id, is_active, password_hash, session_version, failed_login_count, locked_until... và ghi thẳng vào DB. Vi phạm R-16 (chỉ cho phép full_name và phone)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/auth/schemas.py"
                },
