              "properties": {
                "tags": [
                  "security",
                  "CWE-778"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-532",
              "name": "secagent/CWE-532",
              "shortDescription": {
                "text": "Ghi PII (CCCD, mã BHYT, chẩn đoán) vào log ứng dụng"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-532"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-778",
          "level": "error",
          "message": {
            "text": "Job bảo trì xóa bản ghi audit log VIEW_RECORD: compact_repeated_views thực hiện delete(AuditLog) trên bảng audit, trái R-06 (audit log chỉ được thêm, không xóa) và làm mất dấu vết từng lần truy cập bệnh án theo R-05 (mỗi lần xem phải có một bản ghi). Chỉ giữ lần xem đầu mỗi burst nên không thể chứng minh các lần xem sau, ví dụ khi kẻ xấu mở lại hồ sơ nhiều lần."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/audit/maintenance.py"
                },
                "region": {
                  "startLine": 40
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-532",
          "level": "error",
          "message": {
            "text": "Ghi PII (CCCD, mã BHYT, chẩn đoán) vào log ứng dụng: _log_event đưa national_id, insurance_number và diagnosis vào extra=; JsonFormatter xuất mọi trường extra thành khóa cấp cao nhất nên PII đầy đủ (không che) được ghi vào log mỗi lần xem/sửa bệnh án và gửi sang Loki. Vi phạm R-10 và R-11, đồng thời làm lộ dữ liệu cho người không có quyền xem (R-12)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/record/service.py"
                },
                "region": {
                  "startLine": 21
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.97
          }
        }
      ]
    }
  ]
