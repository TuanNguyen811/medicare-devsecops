{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-20",
              "name": "secagent/CWE-20",
              "shortDescription": {
                "text": "parse_lines không kiểm tra số lượng dương/giới hạn: số âm hoặc 0 làm giảm tổng tiền"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-20"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-840",
              "name": "secagent/CWE-840",
              "shortDescription": {
                "text": "change_status cho phép đảo ngược PAID → UNPAID, vi phạm luồng hóa đơn"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-840"
                ],
                "security-severity": "8.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-20",
          "level": "error",
          "message": {
            "text": "parse_lines không kiểm tra số lượng dương/giới hạn: số âm hoặc 0 làm giảm tổng tiền: Số lượng chỉ được ép int(quantity), không kiểm tra > 0 hay giới hạn trên. Ràng buộc min=1/max=99 chỉ ở HTML phía client. Gửi quantity=-5 tạo dòng có amount âm, giảm total_amount và patient_amount (thậm chí âm); R-17 yêu cầu số nguyên dương. Số quá lớn có thể vượt Numeric(12,0) gây lỗi 500."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/billing/service.py"
                },
                "region": {
                  "startLine": 115
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-840",
          "level": "error",
          "message": {
            "text": "change_status cho phép đảo ngược PAID → UNPAID, vi phạm luồng hóa đơn: change_status chỉ kiểm tra status là thành viên của InvoiceStatus và khác trạng thái hiện tại, nên POST status=UNPAID lên hóa đơn đã PAID được chấp nhận. R-17 yêu cầu chỉ UNPAID → PAID và không quay ngược. Hậu quả: lễ tân có thể mở lại hóa đơn đã thu, thêm/sửa dòng dịch vụ rồi thu lại, che giấu việc gian lận tiền; không có audit."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/billing/service.py"
                },
                "region": {
                  "startLine": 148
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}