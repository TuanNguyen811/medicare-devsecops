{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-285",
              "name": "secagent/CWE-285",
              "shortDescription": {
                "text": "Export cho phép DOCTOR/NURSE và xuất CCCD, BHYT đầy đủ không che"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-285"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-1236",
              "name": "secagent/CWE-1236",
              "shortDescription": {
                "text": "Xuất CSV không trung hòa ô bắt đầu bằng =,+,-,@ (CSV/formula injection)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1236"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-285",
          "level": "error",
          "message": {
            "text": "Export cho phép DOCTOR/NURSE và xuất CCCD, BHYT đầy đủ không che: export_patients dùng staff_user (gồm DOCTOR, NURSE) trong khi ma trận chỉ cho ADMIN và RECEPTIONIST xuất. Đồng thời p.national_id và p.insurance_number được ghi nguyên bản, bỏ qua _identifiers/policy.can_view_identifiers, nên bác sĩ/y tá lấy được CCCD, BHYT đầy đủ của mọi bệnh nhân trong phạm vi khoa. Vi phạm R-11 và R-19."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/patient/router.py"
                },
                "region": {
                  "startLine": 98
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.9
          }
        },
        {
          "ruleId": "secagent/CWE-1236",
          "level": "warning",
          "message": {
            "text": "Xuất CSV không trung hòa ô bắt đầu bằng =,+,-,@ (CSV/formula injection): csv_response chỉ chuyển giá trị sang str rồi ghi, không trung hòa ô bắt đầu bằng =, +, -, @, tab, xuống dòng. Các trường full_name, address do người dùng nhập có thể chứa công thức. Vi phạm R-19."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/common/csv_export.py"
                },
                "region": {
                  "startLine": 14
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.9
          }
        }
      ]
    }
  ]
}