{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-640",
              "name": "secagent/CWE-640",
              "shortDescription": {
                "text": "Token đặt lại mật khẩu không hết hạn và dùng lại được nhiều lần"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-640"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secagent/CWE-204",
              "name": "secagent/CWE-204",
              "shortDescription": {
                "text": "/forgot-password tiết lộ email có tồn tại hay không (user enumeration)"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-204"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-640",
          "level": "error",
          "message": {
            "text": "Token đặt lại mật khẩu không hết hạn và dùng lại được nhiều lần: RESET_TOKEN_TTL được định nghĩa nhưng user_for_token không kiểm tra created_at; token cũng không bị xóa/đánh dấu đã dùng sau reset_password. Do đó link hợp lệ vĩnh viễn và dùng được nhiều lần, vi phạm R-18 (một lần, hết hạn 15 phút). Khi bị lộ (log, lịch sử mail) kẻ tấn công chiếm tài khoản bất cứ lúc nào."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/auth/reset.py"
                },
                "region": {
                  "startLine": 47
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "verdict": "TP",
            "confidence": 0.95
          }
        },
        {
          "ruleId": "secagent/CWE-204",
          "level": "warning",
          "message": {
            "text": "/forgot-password tiết lộ email có tồn tại hay không (user enumeration): Khi email không có tài khoản, server trả trang lỗi \"Không tìm thấy tài khoản...\" còn khi có thì redirect 303 kèm flash. Phản hồi khác nhau cho phép dò email nhân viên/bệnh nhân, vi phạm R-18 (và R-07). Endpoint công khai, không có giới hạn tần suất."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/medicare/auth/router.py"
                },
                "region": {
                  "startLine": 124
                }
              }
            }
          ],
          "properties": {
            "security-severity": "5.5",
            "verdict": "TP",
            "confidence": 0.95
          }
        }
      ]
    }
  ]
}