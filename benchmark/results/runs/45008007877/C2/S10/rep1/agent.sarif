{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secagent",
          "version": "0.1.0",
          "informationUri": "https://github.com/TuanNguyen811/medicare-devsecops",
          "rules": [
            {
              "id": "secagent/CWE-494",
              "name": "secagent/CWE-494",
              "shortDescription": {
                "text": "Image backup CronJob dùng digest giả và imagePullPolicy Always"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-494"
                ],
                "security-severity": "3.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secagent/CWE-494",
          "level": "note",
          "message": {
            "text": "Image backup CronJob dùng digest giả và imagePullPolicy Always: Image được ghim bằng digest toàn số 0, là placeholder không hợp lệ. Job sẽ không chạy được, hoặc người dùng sẽ thay bằng tag không ghim. Cần dùng digest thật của image đã ký."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "infra/k8s/backup-cronjob.yaml"
                },
                "region": {
                  "startLine": 33
                }
              }
            }
          ],
          "properties": {
            "security-severity": "3.0",
            "verdict": "TP",
            "confidence": 0.5
          }
        }
      ]
    }
  ]
}