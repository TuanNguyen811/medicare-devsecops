{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_018iPYuvrHb98qkXd9ZeUvPu", "type": "tool_result", "content": [{"type": "text", "text": "<untrusted-code source=\"infra/terraform/main.tf:1-80\">\n    1| # MediCare HMS: sample AWS infrastructure. Scanned by Checkov, never applied (see ../README.md).\n    2| \n    3| data \"aws_caller_identity\" \"current\" {}\n    4| \n    5| data \"aws_availability_zones\" \"available\" {\n    6|   state = \"available\"\n    7| }\n    8| \n    9| locals {\n   10|   name = \"medicare-${var.environment}\"\n   11| }\n   12| \n   13| # --- Encryption key --------------------------------------------------------------\n   14| \n   15| data \"aws_iam_policy_document\" \"kms\" {\n   16|   statement {\n   17|     sid       = \"AccountAdministration\"\n   18|     actions   = [\"kms:*\"]\n   19|     resources = [\"*\"]\n   20|     principals {\n   21|       type        = \"AWS\"\n   22|       identifiers = [\"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\"]\n   23|     }\n   24|   }\n   25| }\n   26| \n   27| resource \"aws_kms_key\" \"medicare\" {\n   28|   description             = \"Encrypts MediCare data at rest (RDS, S3, logs)\"\n   29|   enable_key_rotation     = true\n   30|   deletion_window_in_days = 30\n   31|   policy                  = data.aws_iam_policy_document.kms.json\n   32| }\n   33| \n   34| # --- Network -----------------------------------------------------------------------\n   35| \n   36| resource \"aws_vpc\" \"main\" {\n   37|   cidr_block           = var.vpc_cidr\n   38|   enable_dns_support   = true\n   39|   enable_dns_hostnames = true\n   40|   tags                 = { Name = local.name }\n   41| }\n   42| \n   43| resource \"aws_default_security_group\" \"default\" {\n   44|   vpc_id = aws_vpc.main.id\n   45|   # No ingress/egress rules: the default security group denies all traffic.\n   46| }\n   47| \n   48| resource \"aws_subnet\" \"private\" {\n   49|   count                   = 2\n   50|   vpc_id                  = aws_vpc.main.id\n   51|   cidr_block              = cidrsubnet(var.vpc_cidr, 8, count.index)\n   52|   availability_zone       = data.aws_availability_zones.available.names[count.index]\n   53|   map_public_ip_on_launch = false\n   54|   tags                    = { Name = \"${local.name}-private-${count.index}\" }\n   55| }\n   56| \n   57| resource \"aws_flow_log\" \"vpc\" {\n   58|   vpc_id               = aws_vpc.main.id\n   59|   traffic_type         = \"ALL\"\n   60|   log_destination_type = \"s3\"\n   61|   log_destination      = aws_s3_bucket.logs.arn\n   62| }\n   63| \n   64| resource \"aws_security_group\" \"app\" {\n   65|   name        = \"${local.name}-app\"\n   66|   description = \"MediCare application tasks\"\n   67|   vpc_id      = aws_vpc.main.id\n   68| }\n   69| \n   70| resource \"aws_security_group\" \"db\" {\n   71|   name        = \"${local.name}-db\"\n   72|   description = \"MediCare PostgreSQL, reachable only from the application\"\n   73|   vpc_id      = aws_vpc.main.id\n   74| }\n   75| \n   76| resource \"aws_vpc_security_group_ingress_rule\" \"db_from_app\" {\n   77|   security_group_id            = aws_security_group.db.id\n   78|   description                  = \"PostgreSQL from application security group only\"\n   79|   referenced_security_group_id = aws_security_group.app.id\n   80|   ip_protocol                  = \"tcp\"\n</untrusted-code>"}]}]}}
