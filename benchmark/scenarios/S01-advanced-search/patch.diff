diff --git a/app/medicare/templates/patient/search.html b/app/medicare/templates/patient/search.html
new file mode 100644
index 0000000..608e1ae
--- /dev/null
+++ b/app/medicare/templates/patient/search.html
@@ -0,0 +1,51 @@
+{% extends "base.html" %}
+{% block title %}Tìm kiếm nâng cao{% endblock %}
+{% block content %}
+<h1 class="h5 mb-3">Tìm kiếm bệnh nhân nâng cao</h1>
+<div class="card mc-card">
+  <div class="card-body pb-0">
+    <form class="row g-2 mb-3" method="get" action="/patients/search" role="search">
+      <div class="col-sm-6 col-lg-3">
+        <input class="form-control form-control-sm" type="search" name="phone" value="{{ form.phone }}" maxlength="15" placeholder="Số điện thoại (đầu số)">
+      </div>
+      <div class="col-sm-6 col-lg-3">
+        <input class="form-control form-control-sm" type="search" name="area" value="{{ form.area }}" maxlength="100" placeholder="Địa chỉ (phường, quận, tỉnh)">
+      </div>
+      <div class="col-sm-4 col-lg-2">
+        <input class="form-control form-control-sm" type="number" name="birth_year" value="{{ form.birth_year }}" min="1900" max="2100" placeholder="Năm sinh">
+      </div>
+      <div class="col-sm-5 col-lg-2">
+        <select class="form-select form-select-sm" name="department_id">
+          <option value="">Mọi khoa</option>
+          {% for d in departments %}
+          <option value="{{ d.id }}"{% if form.department_id == d.id | string %} selected{% endif %}>{{ d.name }}</option>
+          {% endfor %}
+        </select>
+      </div>
+      <div class="col-auto"><button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-search"></i> Tìm</button></div>
+    </form>
+  </div>
+  <div class="table-responsive">
+    <table class="table table-sm table-hover align-middle mb-0">
+      <thead>
+        <tr><th>Mã BN</th><th>Họ tên</th><th>Ngày sinh</th><th>Số điện thoại</th><th>Địa chỉ</th><th>CCCD</th><th>Khoa</th></tr>
+      </thead>
+      <tbody>
+        {% for p, ids in rows %}
+        <tr>
+          <td><a href="/patients/{{ p.id }}">{{ p.code }}</a></td>
+          <td>{{ p.full_name }}</td>
+          <td>{{ p.date_of_birth | date_vn }}</td>
+          <td>{{ p.phone }}</td>
+          <td>{{ p.address }}</td>
+          <td class="font-monospace">{{ ids.national_id }}</td>
+          <td>{{ p.department.name if p.department else "" }}</td>
+        </tr>
+        {% else %}
+        <tr><td colspan="7" class="text-center text-secondary py-3">{% if searched %}Không có bệnh nhân phù hợp{% else %}Nhập ít nhất một tiêu chí để tìm{% endif %}</td></tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  </div>
+</div>
+{% endblock %}
