+from datetime import datetime
+
+from sqlalchemy import DateTime, ForeignKey, String, Text, func
+from sqlalchemy.orm import Mapped, mapped_column, relationship
+
+from medicare.auth.models import User
+from medicare.db import Base
+
+
+class Announcement(Base):
+    __tablename__ = "announcements"
+
+    id: Mapped[int] = mapped_column(primary_key=True)
+    title: Mapped[str] = mapped_column(String(200))
+    # Already sanitized (service.clean_body); rendered as HTML on the home page.
+    body_html: Mapped[str] = mapped_column(Text)
+    author_id: Mapped[int] = mapped_column(ForeignKey("users.id"))
+    created_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True), server_default=func.now()
+    )
+
+    author: Mapped[User] = relationship(lazy="joined")
diff --git a/app/medicare/announcement/router.py b/app/medicare/announcement/router.py
new file mode 100644
index 0000000..e7b7ef6
--- /dev/null
+++ b/app/medicare/announcement/router.py
@@ -0,0 +1,69 @@
+from fastapi import APIRouter, Depends, Form, Request
+from fastapi.responses import RedirectResponse, Response
+from sqlalchemy.orm import Session
+
+from medicare.announcement import service
+from medicare.announcement.models import Announcement
+from medicare.auth.models import Role, User
+from medicare.common.auth import require_roles
+from medicare.common.csrf import verify_csrf
+from medicare.common.errors import NotFound
+from medicare.common.ids import ObjectId
+from medicare.common.templating import flash, render
+from medicare.db import get_db
+
+router = APIRouter()
+
+admin_user = require_roles(Role.ADMIN)
+
+
+def _page(request: Request, db: Session, *, values=None, errors=None, status_code=200):
+    return render(request, "announcement/admin.html", {
+        "announcements": service.latest(db, limit=50),
+        "values": values or {},
+        "errors": errors or [],
+        "max_body": service.MAX_BODY,
+        "breadcrumbs": [("Trang chủ", "/"), ("Thông báo", None)],
+    }, status_code=status_code)
+
+
+@router.get("/admin/announcements")
+def announcements_page(
+    request: Request, user: User = Depends(admin_user), db: Session = Depends(get_db)
+) -> Response:
+    return _page(request, db)
+
+
+@router.post("/admin/announcements", dependencies=[Depends(verify_csrf)])
+def create_announcement(
+    request: Request,
+    title: str = Form(""),
+    body: str = Form(""),
+    user: User = Depends(admin_user),
+    db: Session = Depends(get_db),
+) -> Response:
+    try:
+        service.create(db, user, title, body)
+    except service.AnnouncementError as exc:
+        return _page(request, db, values={"title": title, "body": body}, errors=[str(exc)],
+                     status_code=400)
+    db.commit()
+    flash(request, "Đã đăng thông báo")
+    return RedirectResponse("/admin/announcements", status_code=303)
+
+
+@router.post("/admin/announcements/{announcement_id}/delete",
+             dependencies=[Depends(verify_csrf)])
+def delete_announcement(
+    request: Request,
+    announcement_id: ObjectId,
+    user: User = Depends(admin_user),
+    db: Session = Depends(get_db),
+) -> Response:
+    announcement = db.get(Announcement, announcement_id)
+    if announcement is None:
+        raise NotFound
+    service.delete(db, announcement)
+    db.commit()
+    flash(request, "Đã gỡ thông báo")
+    return RedirectResponse("/admin/announcements", status_code=303)
diff --git a/app/medicare/announcement/service.py b/app/medicare/announcement/service.py
new file mode 100644
index 0000000..4a51089
--- /dev/null
+++ b/app/medicare/announcement/service.py
@@ -0,0 +1,63 @@
+"""Hospital announcements shown on the home page, written by administrators.
+
+The body is limited rich text. It is cleaned with bleach against a strict allowlist
+before it is stored, and only the cleaned HTML is ever rendered.
+"""
+
+import bleach
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from medicare.announcement.models import Announcement
+from medicare.auth.models import User
+
+MAX_TITLE = 200
+MAX_BODY = 5000
+HOME_LIMIT = 5
+
+ALLOWED_TAGS = frozenset({
+    "p", "br", "strong", "b", "em", "i", "u", "ul", "ol", "li", "blockquote", "a",
+})
+ALLOWED_ATTRIBUTES = {"a": ["href", "title"]}
+ALLOWED_PROTOCOLS = frozenset({"http", "https", "mailto"})
+
+
+class AnnouncementError(ValueError):
+    """Invalid announcement data; the message is user-facing."""
+
+
+def clean_body(raw: str) -> str:
+    return bleach.clean(
+        raw,
+        tags=ALLOWED_TAGS,
+        attributes=ALLOWED_ATTRIBUTES,
+        protocols=ALLOWED_PROTOCOLS,
+        strip=True,
+        strip_comments=True,
+    )
+
+
+def create(db: Session, author: User, title: str, body: str) -> Announcement:
+    title, body = title.strip(), body.strip()
+    if not 1 <= len(title) <= MAX_TITLE:
+        raise AnnouncementError(f"Tiêu đề: bắt buộc, tối đa {MAX_TITLE} ký tự")
+    if not 1 <= len(body) <= MAX_BODY:
+        raise AnnouncementError(f"Nội dung: bắt buộc, tối đa {MAX_BODY} ký tự")
+    body_html = clean_body(body)
+    if not body_html.strip():
+        raise AnnouncementError("Nội dung: bắt buộc")
+    announcement = Announcement(title=title, body_html=body_html, author_id=author.id)
+    db.add(announcement)
+    db.flush()
+    return announcement
+
+
+def latest(db: Session, limit: int = HOME_LIMIT) -> list[Announcement]:
+    stmt = select(Announcement).order_by(Announcement.created_at.desc(),
+                                         Announcement.id.desc()).limit(limit)
+    return list(db.scalars(stmt).unique())
+
+
+def delete(db: Session, announcement: Announcement) -> None:
+    db.delete(announcement)
+    db.flush()
