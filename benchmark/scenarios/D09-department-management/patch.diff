+          <td>{{ d.name }}</td>
+          <td class="text-secondary">{{ d.description or "" }}</td>
+          <td class="text-end"><a class="btn btn-outline-secondary btn-sm" href="/admin/departments/{{ d.id }}/edit"><i class="bi bi-pencil"></i> Sửa</a></td>
