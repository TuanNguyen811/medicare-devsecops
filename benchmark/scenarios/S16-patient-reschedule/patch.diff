+    appt = make_appt(db, me, doc, status=AppointmentStatus.CONFIRMED)
+    login(client, make_user(db, Role.PATIENT, patient=me))
+    assert reschedule(client, appt, slot(days=2)).status_code == 404
+    db.refresh(appt)
+    assert appt.scheduled_at == slot_dt()
