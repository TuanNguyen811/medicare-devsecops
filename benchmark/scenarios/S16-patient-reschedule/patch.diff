diff --git a/app/medicare/templates/appointment/reschedule.html b/app/medicare/templates/appointment/reschedule.html
new file mode 100644
index 0000000..9c9815b
--- /dev/null
+++ b/app/medicare/templates/appointment/reschedule.html
@@ -0,0 +1,33 @@
+{% extends "base.html" %}
+{% block title %}Đổi lịch hẹn{% endblock %}
+{% block content %}
+<h1 class="h5 mb-3">Đổi lịch hẹn khám</h1>
+{% if errors %}
+<div class="alert alert-danger py-2" role="alert">
+  <ul class="mb-0 ps-3">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
+</div>
+{% endif %}
+<div class="card mc-card" style="max-width: 640px;">
+  <div class="card-body">
+    {% set label, color = status_labels[appt.status.value] %}
+    <dl class="row small mb-3">
+      <dt class="col-sm-4">Bệnh nhân</dt><dd class="col-sm-8">{{ appt.patient.code }} - {{ appt.patient.full_name }}</dd>
+      <dt class="col-sm-4">Bác sĩ</dt><dd class="col-sm-8">{{ appt.doctor.full_name }}</dd>
+      <dt class="col-sm-4">Thời gian hiện tại</dt><dd class="col-sm-8">{{ appt.scheduled_at | datetime_vn }}</dd>
+      <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8"><span class="badge text-bg-{{ color }}">{{ label }}</span></dd>
+    </dl>
+    <form method="post" action="/appointments/{{ appt.id }}/reschedule">
+      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
+      <div class="mb-3">
+        <label class="form-label" for="scheduled_at">Thời gian hẹn mới</label>
+        <input class="form-control" id="scheduled_at" name="scheduled_at" type="datetime-local" step="1800" value="{{ values.scheduled_at or '' }}" required>
+        <div class="form-text">Theo mốc 30 phút, cùng bác sĩ. Ví dụ 08:00, 08:30.</div>
+      </div>
+      <div class="d-flex gap-2">
+        <button class="btn btn-primary" type="submit">Đổi lịch</button>
+        <a class="btn btn-outline-secondary" href="/appointments">Quay lại</a>
+      </div>
+    </form>
+  </div>
+</div>
+{% endblock %}
