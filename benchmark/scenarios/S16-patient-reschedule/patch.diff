+    login(client, make_user(db, Role.RECEPTIONIST))
+    assert reschedule(client, appt, slot(days=3, hour=8)).status_code == 303
+    db.refresh(appt)
+    assert appt.scheduled_at == slot_dt(3, 8) and appt.status == AppointmentStatus.CONFIRMED
+
