+@pytest.fixture
+def sent(monkeypatch):
+    """Capture outgoing SMS instead of calling the gateway."""
+    messages = []
+
+    def fake_send(phone, text):
+        messages.append((phone, text))
+        return "1"
+
+    monkeypatch.setattr(sms, "send_sms", fake_send)
+    return messages
